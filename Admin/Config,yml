backend:
  name: turbo-github
  turbo_site_id: REPLACE_WITH_YOUR_TURBO_SITE_ID
  branch: main

media_folder: uploads
public_folder: uploads
editor:
  preview: false

collections:
  - name: journal
    label: Daily Journal
    format: journal-json
    files:
      - name: entries
        label: Journal Entries
        file: entries.json
        fields:
          - name: entries
            label: Entries
            label_singular: Entry
            widget: list
            summary: '{{fields.date}} — {{fields.title}}'
            collapsed: true
            fields:
              - { name: title, label: Title, widget: string }
              - name: date
                label: Date
                widget: datetime
                format: YYYY-MM-DD
                date_format: YYYY-MM-DD
                time_format: false
              - { name: topic, label: Topic, widget: select, options: [Minneapolis, Minnesota, World], default: Minneapolis }
              - { name: body, label: Your writing, widget: text }
              - { name: sample, label: Sample entry, widget: boolean, default: false, required: false }
